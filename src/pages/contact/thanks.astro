---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { site } from "../../data/site";

const title = `Message Sent | ${site.name}`;
const description = "Confirmation page for the Worker Pay Tools contact form.";
const thanksUrl = `${site.url}/contact/thanks/`;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: title,
  description,
  url: thanksUrl,
  isPartOf: {
    "@type": "WebSite",
    name: site.name,
    url: site.url
  }
};
---

<BaseLayout title={title} description={description} structuredData={structuredData}>
  <section class="tool-page-intro">
    <div class="tool-page-kicker">Contact</div>
    <h1>Thanks. Your message was sent.</h1>
    <p>Your message was routed successfully. You can head back to the calculators or send another note.</p>
  </section>

  <section class="detail-grid">
    <article class="detail-card">
      <h2>What next</h2>
      <p>We have your message. If you included a calculator name and the numbers you used, that helps us respond much faster.</p>
      <div class="calc-actions">
        <a class="primary-button" href="/#tools">Back to tools</a>
        <a class="secondary-button" href="/contact/">Send another message</a>
      </div>
    </article>

    <article class="detail-card">
      <div class="disclaimer-card">
        Worker Pay Tools is for educational and planning purposes only. It does not replace professional payroll, tax, legal, or accounting advice.
      </div>
    </article>
  </section>
</BaseLayout>
